# Use with: docker compose --env-file .env.docker up -d --build
COMPOSE_PROJECT_NAME=dmlv4

# Images and build tool version
DML_BACKEND_IMAGE=dmlv4-backend:local
DML_FRONTEND_IMAGE=dmlv4-frontend:local
UV_VERSION=0.11.14
PYTHON_BASE_IMAGE=python:3.13-slim-bookworm
NODE_BASE_IMAGE=node:22-alpine
NGINX_BASE_IMAGE=nginx:1.28-alpine

# Bootstrap YAML: app, MongoDB and logging only.
DML_BOOTSTRAP_CONFIG=./backend/config/config.yaml
DML_ENV=production
TZ=Asia/Shanghai

# Host port bindings. The API defaults to loopback because Nginx is the public entrypoint.
DML_API_BIND_ADDRESS=127.0.0.1
DML_API_PORT=8801
DML_FRONTEND_BIND_ADDRESS=0.0.0.0
DML_FRONTEND_PORT=8080

# The frontend uses the same origin and Nginx proxies this path to the API container.
VITE_API_BASE_URL=/api/v1

# Optional Docker log rotation.
DML_LOG_MAX_SIZE=20m
DML_LOG_MAX_FILES=5

# Only required for the one-time `ops` profile commands.
# This file contains Kafka/Redis/MinIO/JWT secrets and must not be committed.
DML_RUNTIME_CONFIG_FILE=./backend/config/runtime.full.yaml
DML_ADMIN_USER_ID=admin
DML_ADMIN_USERNAME=系统管理员
DML_ADMIN_EMAIL=
# Set DML_ADMIN_PASSWORD in the shell instead of storing it here.

# Bootstrap-only production configuration.
# Runtime settings are managed in MongoDB through the System Config page.
app:
  debug: false
  host: 0.0.0.0
  port: 8801
  service_name: dmlv4-backend
  cors_origins:
  - http://localhost:3000
  trusted_proxies: []
  dev_bypass_auth: false
  dev_user_id: dev_admin

mongodb:
  uri: mongodb://localhost:27017
  db_name: workflow_db

logging:
  console_level: INFO
  log_dir: logs
  retention:
    info_days: 7
    error_days: 30
    debug_days: 3
  json_format: true
  enable_compress: true
  trace_enabled: true
  slow_query_threshold_ms: 200
  slow_request_threshold_ms: 800
  module_levels: {}
